{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spiceflow-website-worker",
  "main": "./src/server.tsx",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker reads prerendered staticPage files through this binding.
  "assets": {
    "binding": "ASSETS",
  },
}
