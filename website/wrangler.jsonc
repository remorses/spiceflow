{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spiceflow-website-worker",
  "main": "./src/server.tsx",
  "compatibility_date": "2026-03-15",
  "compatibility_flags": ["nodejs_compat"],
  // Worker runs first so middleware also runs for prerendered staticPage routes.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
  },
}
